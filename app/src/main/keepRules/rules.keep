# Add project specific R8 rules here.
# AGP will combine all keep rule files in src/main/keepRules to pass to R8
#
# For more details, see
#   https://d.android.com/r/tools/r8/keep-rules

# If your project uses WebView with JS, uncomment the following
# and specify the fully qualified class name to the JavaScript interface
# class:
#-keepclassmembers class fqcn.of.javascript.interface.for.webview {
#   public *;
#}

# Glance widget tap callbacks are created by class name via reflection
-keep class * implements androidx.glance.appwidget.action.ActionCallback {
    <init>();
}

# WorkManager (Glance ke through aata hai) ka Room database reflection se banta hai
-keep class * extends androidx.room.RoomDatabase {
    <init>();
}

# WorkManager InputMerger (OverwritingInputMerger) reflection se banta hai
-keep class * extends androidx.work.InputMerger {
    <init>();
}

-keepclassmembers class * extends androidx.datastore.preferences.protobuf.GeneratedMessageLite {
    <fields>;
}

-keepattributes SourceFile,LineNumberTable